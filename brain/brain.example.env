# brain-api v2 settings. setup.sh copies this to .env and keeps your v1 token.
BRAIN_API_TOKEN=
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8010
# systemd units shown on the desk (and restartable from it), without .service
BRAIN_SERVICES=brain-api,antara-ml,antara-frontend,antara-tunnel
# Wake-on-LAN targets, name=MAC, comma separated
BRAIN_WOL=desktop=AA:BB:CC:DD:EE:FF
BRAIN_OLLAMA_URL=http://127.0.0.1:11434
BRAIN_ASK_MODEL=qwen2.5:7b-instruct
# AdGuard Home admin (Phase 2). Leave URL empty until AdGuard is running.
BRAIN_ADGUARD_URL=http://127.0.0.1:3000
BRAIN_ADGUARD_USER=
BRAIN_ADGUARD_PASS=
# Murmur, for transcribing Anamnis audio dropped in the inbox
BRAIN_MURMUR_URL=http://127.0.0.1:7341
BRAIN_MURMUR_TOKEN=
BRAIN_INBOX_DIR=/home/__USER__/brain-inbox
